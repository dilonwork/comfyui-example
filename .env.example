# Copy to .env and edit. CLI flags always override these values.
# Server shared by all examples (host:port)
COMFYUI_SERVER=127.0.0.1:8188

# --- 01_api_txt2img.py ---
TXT2IMG_PROMPT=beautiful scenery, nature, glass bottle landscape, purple galaxy inside the bottle, highly detailed
TXT2IMG_NEGATIVE=text, watermark, blurry, low quality
# Empty = random seed on every run
TXT2IMG_SEED=
TXT2IMG_STEPS=20
TXT2IMG_OUT=result.png

# --- 02_api_img2img.py ---
IMG2IMG_INPUT=photo.png
IMG2IMG_PROMPT=masterpiece, best quality, vibrant colors, highly detailed
# 0 = keep input, 1 = ignore input (pure txt2img)
IMG2IMG_DENOISE=0.75
# Empty = random seed on every run
IMG2IMG_SEED=
IMG2IMG_OUT=result_img2img.png
